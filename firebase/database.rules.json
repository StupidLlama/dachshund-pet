{
  "rules": {
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ( (newData.exists() && (!data.exists() || data.child('exp').val() < now) && newData.child('by').val() === auth.uid && ((newData.child('kind').val() === 'home' && root.child('homes').child(newData.child('target').val()).child('members').child(auth.uid).exists()) || (newData.child('kind').val() === 'room' && ((root.child('rooms').child(newData.child('target').val()).child('slots').child('a').child('home').isString() && root.child('homes').child(root.child('rooms').child(newData.child('target').val()).child('slots').child('a').child('home').val()).child('members').child(auth.uid).exists()) || (root.child('rooms').child(newData.child('target').val()).child('slots').child('b').child('home').isString() && root.child('homes').child(root.child('rooms').child(newData.child('target').val()).child('slots').child('b').child('home').val()).child('members').child(auth.uid).exists()))))) || (!newData.exists() && data.exists() && (data.child('by').val() === auth.uid || data.child('exp').val() < now)) )",
        ".validate": "$code.matches(/^[0-9]{6}$/) && newData.hasChildren(['kind', 'target', 'by', 'exp']) && (newData.child('kind').val() === 'home' || newData.child('slot').isString())",
        "kind": {
          ".validate": "newData.isString() && newData.val().matches(/^(home|room)$/)"
        },
        "target": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "slot": {
          ".validate": "newData.isString() && newData.val().matches(/^[ab]$/)"
        },
        "by": {
          ".validate": "newData.isString()"
        },
        "exp": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 1200000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "homes": {
      "$home": {
        ".read": "auth != null && root.child('homes').child($home).child('members').child(auth.uid).exists()",
        "meta": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['created'])",
          "created": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ( (auth.uid === $uid && newData.exists() && !data.exists() && !root.child('homes').child($home).child('meta').exists()) || (auth.uid === $uid && newData.exists() && !data.exists() && newData.child('code').isString() && root.child('codes').child(newData.child('code').val()).child('kind').val() === 'home' && root.child('codes').child(newData.child('code').val()).child('target').val() === $home && root.child('codes').child(newData.child('code').val()).child('exp').val() > now) || (auth.uid === $uid && data.exists() && newData.exists()) || (!newData.exists() && data.exists() && (auth.uid === $uid || root.child('homes').child($home).child('members').child(auth.uid).exists())) )",
            ".validate": "newData.hasChildren(['kind', 'joined'])",
            "kind": {
              ".validate": "newData.isString() && newData.val().matches(/^(pet|phone)$/)"
            },
            "joined": {
              ".validate": "newData.isNumber()"
            },
            "code": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "name": {
          ".write": "auth != null && (root.child('homes').child($home).child('members').child(auth.uid).exists() || !root.child('homes').child($home).child('meta').exists())",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "rooms": {
          "$room": {
            ".write": "auth != null && root.child('homes').child($home).child('members').child(auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().matches(/^[ab]+$/) && ((newData.val().beginsWith('a') && root.child('rooms').child($room).child('slots').child('a').child('home').val() === $home) || (newData.val().beginsWith('b') && root.child('rooms').child($room).child('slots').child('b').child('home').val() === $home))"
          }
        },
        "todo": {
          "$item": {
            ".write": "auth != null && root.child('homes').child($home).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['text', 'done', 'ts', 'by'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "done": {
              ".validate": "newData.isBoolean()"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().matches(/^(pet|phone)$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "todo_date": {
          ".write": "auth != null && root.child('homes').child($home).child('members').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "settings": {
          ".write": "auth != null && root.child('homes').child($home).child('members').child(auth.uid).exists()",
          "wake_time": {
            ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
          },
          "focus_min": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 120"
          },
          "break_min": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && ((root.child('rooms').child($room).child('slots').child('a').child('home').isString() && root.child('homes').child(root.child('rooms').child($room).child('slots').child('a').child('home').val()).child('members').child(auth.uid).exists()) || (root.child('rooms').child($room).child('slots').child('b').child('home').isString() && root.child('homes').child(root.child('rooms').child($room).child('slots').child('b').child('home').val()).child('members').child(auth.uid).exists()))",
        "meta": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['created', 'size'])",
          "created": {
            ".validate": "newData.val() === now"
          },
          "size": {
            ".validate": "newData.isNumber() && newData.val() === 2"
          },
          "$other": {
            ".validate": false
          }
        },
        "slots": {
          "$slot": {
            ".write": "auth != null && ( (newData.exists() && !data.exists() && root.child('homes').child(newData.child('home').val()).child('members').child(auth.uid).exists() && (!root.child('rooms').child($room).child('meta').exists() || (newData.child('code').isString() && root.child('codes').child(newData.child('code').val()).child('kind').val() === 'room' && root.child('codes').child(newData.child('code').val()).child('target').val() === $room && root.child('codes').child(newData.child('code').val()).child('slot').val() === $slot && root.child('codes').child(newData.child('code').val()).child('exp').val() > now))) || (!newData.exists() && data.exists() && root.child('homes').child(data.child('home').val()).child('members').child(auth.uid).exists()) )",
            ".validate": "$slot.matches(/^[ab]$/) && newData.hasChildren(['home'])",
            "home": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "code": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "names": {
          "$slot": {
            ".write": "auth != null && (root.child('rooms').child($room).child('slots').child($slot).child('home').isString() && root.child('homes').child(root.child('rooms').child($room).child('slots').child($slot).child('home').val()).child('members').child(auth.uid).exists())",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          }
        },
        "messages": {
          ".indexOn": [
            "ts"
          ],
          "$msg": {
            ".write": "auth != null && !data.exists() && ((root.child('rooms').child($room).child('slots').child('a').child('home').isString() && root.child('homes').child(root.child('rooms').child($room).child('slots').child('a').child('home').val()).child('members').child(auth.uid).exists()) || (root.child('rooms').child($room).child('slots').child('b').child('home').isString() && root.child('homes').child(root.child('rooms').child($room).child('slots').child('b').child('home').val()).child('members').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['from', 'text', 'ts', 'via'])",
            "from": {
              ".validate": "newData.isString() && newData.val().matches(/^[ab]$/) && (root.child('rooms').child($room).child('slots').child(newData.val()).child('home').isString() && root.child('homes').child(root.child('rooms').child($room).child('slots').child(newData.val()).child('home').val()).child('members').child(auth.uid).exists())"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "via": {
              ".validate": "newData.isString() && newData.val().matches(/^(pet|phone)$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "status": {
          "$slot": {
            ".write": "auth != null && (root.child('rooms').child($room).child('slots').child($slot).child('home').isString() && root.child('homes').child(root.child('rooms').child($room).child('slots').child($slot).child('home').val()).child('members').child(auth.uid).exists())",
            "pet": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "delivered": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "seen": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
